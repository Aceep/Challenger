# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app (http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"

# Discord application (https://discord.com/developers/applications)
# OAuth2 → Redirect URL must be: {AUTH_URL}/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Bot section → token ; General Information → public key
# The public key also signs the *webhook events*: Developer Portal → Webhooks →
# Endpoint URL = {AUTH_URL}/api/discord/events, then subscribe to
# « Application Authorized » so the bot DMs whoever adds it to a new server.
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
# Default guild for `npm run discord:register` (the in-app setup uses the challenge's id)
DISCORD_GUILD_ID=""
# Discord id of the first organiser, seeded as an ADMIN invite by `npm run db:seed`
ADMIN_DISCORD_ID=""

# Shared secret for GET /api/cron/tick?secret=… (Vercel cron + external scheduler)
CRON_SECRET=""

# Web push (VAPID). Generate the pair once with: npx web-push generate-vapid-keys
# The public key is shipped to the browser (hence NEXT_PUBLIC_), the private one
# signs every send. Leave them empty and push is simply off — the build and the
# app keep working, `notifyUsers` becomes a no-op.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address the push services may use: a "mailto:" or an "https:" URL
VAPID_SUBJECT="mailto:contact@example.com"
