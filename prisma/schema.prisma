generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) tables
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  membership TeamMember?
  captainOf  Team[]      @relation("TeamCaptain")
  books      Book[]
  questCompletions QuestCompletion[]
  ballots    VoteBallot[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge core
// ---------------------------------------------------------------------------

enum ChallengeStatus {
  DRAFT
  ACTIVE
  FINISHED
}

model Challenge {
  id                      String          @id @default(cuid())
  name                    String
  startAt                 DateTime
  endAt                   DateTime
  status                  ChallengeStatus @default(DRAFT)
  /// Points granted per page read (e.g. 0.1 = 1 point per 10 pages)
  pointsPerPage           Float           @default(0.1)
  bingoLineBonus          Int             @default(25)
  bingoFullBonus          Int             @default(100)
  discordGuildId          String?
  discordGeneralChannelId String?
  createdAt               DateTime        @default(now())

  teams      Team[]
  invites    Invite[]
  bingoGrids BingoGrid[]
  quests     Quest[]
  story      Story?
}

model Team {
  id               String   @id @default(cuid())
  challengeId      String
  name             String
  color            String   @default("#6366f1")
  captainId        String?
  /// Team channel for story votes and announcements
  discordChannelId String?
  /// Team "librairie" channel where /ajouter-un-livre and /modifier-un-livre are allowed
  discordLibraryChannelId String?
  createdAt        DateTime @default(now())

  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  captain     User?        @relation("TeamCaptain", fields: [captainId], references: [id])
  members     TeamMember[]
  invites     Invite[]
  pointEvents      PointEvent[]
  modifiers        Modifier[]
  bingoFills       BingoFill[]
  targetedQuests   Quest[]           @relation("QuestTarget")
  questCompletions QuestCompletion[]
  storyState       TeamStoryState?
  storyVisits      StoryVisit[]
  votes            Vote[]
  alliancesA       Alliance[]        @relation("AllianceA")
  alliancesB       Alliance[]        @relation("AllianceB")

  @@unique([challengeId, name])
}

model TeamMember {
  userId   String   @id
  teamId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// Admin pre-registers a Discord user id; on first login the user is attached to the team.
model Invite {
  id          String    @id @default(cuid())
  challengeId String
  discordId   String
  teamId      String?
  role        Role      @default(PLAYER)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([challengeId, discordId])
}

model Book {
  id         String   @id @default(cuid())
  userId     String
  title      String
  author     String
  pages      Int
  /// BD / manga / roman graphique: counts as half a book for quests and bingo cells.
  isGraphic  Boolean  @default(false)
  finishedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointEvents PointEvent[]
  bingoFill   BingoFill?
  questBook   QuestBook?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Bingo — one grid definition per scope; fills are per player or per team
// ---------------------------------------------------------------------------

enum BingoScope {
  PLAYER
  TEAM
}

model BingoGrid {
  id          String     @id @default(cuid())
  challengeId String
  scope       BingoScope
  title       String
  size        Int        @default(5)
  createdAt   DateTime   @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  cells     BingoCell[]

  @@unique([challengeId, scope])
}

model BingoCell {
  id     String @id @default(cuid())
  gridId String
  row    Int
  col    Int
  prompt String

  grid  BingoGrid   @relation(fields: [gridId], references: [id], onDelete: Cascade)
  fills BingoFill[]

  @@unique([gridId, row, col])
}

/// A book placed on a team-grid cell. A cell holds up to 2 books (weights: book 1, graphique ½).
model BingoFill {
  id        String   @id @default(cuid())
  cellId    String
  bookId    String   @unique
  teamId    String
  createdAt DateTime @default(now())

  cell BingoCell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  book Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  team Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([cellId, teamId])
}

// ---------------------------------------------------------------------------
// Quests — honor-system missions, team-wide or per player
// ---------------------------------------------------------------------------

enum QuestType {
  TEAM
  INDIVIDUAL
}

enum QuestOrigin {
  ADMIN
  STORY
}

/// ACTION = validated with a button (honor system); LECTURE = completed by attaching book(s).
enum QuestKind {
  ACTION
  LECTURE
}

model Quest {
  id           String      @id @default(cuid())
  challengeId  String
  title        String
  description  String      @default("")
  type         QuestType
  kind         QuestKind   @default(ACTION)
  points       Int
  openAt       DateTime?
  closeAt      DateTime?
  /// When set, only this team sees/completes the quest (story-triggered rival quests).
  targetTeamId String?
  origin       QuestOrigin @default(ADMIN)
  createdAt    DateTime    @default(now())

  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  targetTeam  Team?             @relation("QuestTarget", fields: [targetTeamId], references: [id], onDelete: Cascade)
  completions QuestCompletion[]
  books       QuestBook[]

  @@index([challengeId])
}

/// A book attached to a LECTURE quest. One quest per book.
model QuestBook {
  id        String   @id @default(cuid())
  questId   String
  bookId    String   @unique
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([questId, teamId])
  @@index([questId, userId])
}

/// Exactly one of userId (individual) / teamId (team) is set.
model QuestCompletion {
  id            String   @id @default(cuid())
  questId       String
  userId        String?
  teamId        String?
  completedById String
  createdAt     DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([questId, userId])
  @@unique([questId, teamId])
}

// ---------------------------------------------------------------------------
// Story — one branching "you're the hero" story per challenge, each team walks its own path
// ---------------------------------------------------------------------------

model Story {
  id             String   @id @default(cuid())
  challengeId    String   @unique
  title          String
  /// Hours a vote stays open before auto-resolution
  voteHours      Int      @default(48)
  startNodeId    String?
  createdAt      DateTime @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  nodes     StoryNode[]
}

model StoryNode {
  id                 String  @id @default(cuid())
  storyId            String
  title              String
  /// Chapter text (plain text / light markdown)
  body               String
  sortOrder          Int     @default(0)
  /// Gating: the chapter's vote only opens once the team meets every set condition
  requiredQuestId    String?
  requiredBingoLines Int?
  requiredPoints     Int?

  story       Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  choices     StoryChoice[] @relation("NodeChoices")
  incoming    StoryChoice[] @relation("ChoiceTarget")
  teamStates  TeamStoryState[]
  votes       Vote[]
  visits      StoryVisit[]

  @@index([storyId, sortOrder])
}

model StoryChoice {
  id              String  @id @default(cuid())
  nodeId          String
  label           String
  targetNodeId    String?
  /// Votable only once the team completed this quest
  lockedByQuestId String?
  /// JSON array of effects, validated by lib/story/effects.ts
  effects         Json    @default("[]")
  sortOrder       Int     @default(0)

  node    StoryNode  @relation("NodeChoices", fields: [nodeId], references: [id], onDelete: Cascade)
  target  StoryNode? @relation("ChoiceTarget", fields: [targetNodeId], references: [id], onDelete: SetNull)
  ballots VoteBallot[]
  votes   Vote[]

  @@index([nodeId, sortOrder])
}

model TeamStoryState {
  teamId        String   @id
  currentNodeId String
  updatedAt     DateTime @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  currentNode StoryNode @relation(fields: [currentNodeId], references: [id], onDelete: Cascade)
}

model StoryVisit {
  id        String   @id @default(cuid())
  teamId    String
  nodeId    String
  choiceLabel String?
  arrivedAt DateTime @default(now())

  team Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  node StoryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([teamId, arrivedAt])
}

enum VoteStatus {
  OPEN
  AWAITING_TARGET
  RESOLVED
}

model Vote {
  id               String     @id @default(cuid())
  teamId           String
  nodeId           String
  status           VoteStatus @default(OPEN)
  deadline         DateTime
  resultChoiceId   String?
  /// Rival team chosen by the captain for hostile/alliance effects
  targetTeamId     String?
  discordMessageId String?
  createdAt        DateTime   @default(now())
  resolvedAt       DateTime?

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  node         StoryNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  resultChoice StoryChoice? @relation(fields: [resultChoiceId], references: [id], onDelete: SetNull)
  ballots      VoteBallot[]

  @@index([teamId, status])
}

model VoteBallot {
  voteId    String
  userId    String
  choiceId  String
  createdAt DateTime @default(now())

  vote   Vote        @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice StoryChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@id([voteId, userId])
}

/// Two allied teams: members may vote in each other's story votes.
model Alliance {
  id        String   @id @default(cuid())
  teamAId   String
  teamBId   String
  createdAt DateTime @default(now())

  teamA Team @relation("AllianceA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB Team @relation("AllianceB", fields: [teamBId], references: [id], onDelete: Cascade)

  @@unique([teamAId, teamBId])
}

// ---------------------------------------------------------------------------
// Scoring ledger — append-only source of truth for team scores
// ---------------------------------------------------------------------------

enum PointSource {
  READING
  BINGO
  QUEST
  STORY
  ADMIN
}

model PointEvent {
  id        String      @id @default(cuid())
  teamId    String
  userId    String?
  source    PointSource
  /// Final amount after multipliers, may be negative (undo, steal)
  amount    Int
  /// Amount before multiplier, for audit
  baseAmount Int
  multiplier Float      @default(1)
  label     String
  bookId    String?
  refId     String?
  createdAt DateTime    @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

/// Temporary boost/handicap applied to a team's incoming points.
model Modifier {
  id         String   @id @default(cuid())
  teamId     String
  multiplier Float
  label      String
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startAt, endAt])
}
