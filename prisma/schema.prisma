generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) tables
// ---------------------------------------------------------------------------

enum ChallengeRole {
  ORGANIZER
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  /// Platform super-admin: organiser of every challenge, sees every edition.
  isSuperAdmin  Boolean   @default(false)
  /// First login guided tour: set once Kyle's visit is finished or skipped.
  onboardedAt   DateTime?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  memberships       ChallengeMember[]
  teamMemberships   TeamMember[]
  createdChallenges Challenge[]       @relation("ChallengeCreator")
  captainOf         Team[]            @relation("TeamCaptain")
  books             Book[]
  editedBooks       Book[]            @relation("BookEditor")
  deputyOf          Team[]            @relation("TeamDeputy")
  ballots           VoteBallot[]
  questions         Question[]
  questionMessages  QuestionMessage[]
  pendingReadings   PendingReading[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge core
// ---------------------------------------------------------------------------

enum ChallengeStatus {
  DRAFT
  ACTIVE
  FINISHED
}

model Challenge {
  id                      String          @id @default(cuid())
  name                    String
  startAt                 DateTime
  endAt                   DateTime
  status                  ChallengeStatus @default(DRAFT)
  /// Accent colour of the edition (banner, edition cards)
  color                   String          @default("#2E4A7D")
  /// Points granted per page read (e.g. 0.1 = 1 point per 10 pages)
  pointsPerPage           Float           @default(0.1)
  bingoLineBonus          Int             @default(25)
  bingoFullBonus          Int             @default(100)
  discordGuildId          String?
  discordGeneralChannelId String?
  /// Forum channel ("faq") where every question becomes a thread
  discordFaqChannelId     String?
  /// Role pinged on every new question ("Organisateurs")
  discordAdminRoleId      String?
  /// Ids of the forum tags: { open, answered, resolved }
  discordFaqTags          Json?
  /// Last FAQ poll of the forum threads (throttle)
  faqSyncedAt             DateTime?
  /// Last Sunday leaderboard post (catch-up logic)
  lastWeeklyPostAt        DateTime?
  /// Organiser who created the edition (kept for the challenge list)
  createdById             String?
  createdAt               DateTime        @default(now())

  createdBy   User?             @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members     ChallengeMember[]
  teamMembers TeamMember[]
  teams       Team[]
  invites     Invite[]
  bingoGrids  BingoGrid[]
  quests      Quest[]
  story       Story?
  questions   Question[]

  @@index([discordGuildId])
}

/// A person's role inside one challenge. The tenant membership: no global role.
model ChallengeMember {
  challengeId String
  userId      String
  role        ChallengeRole @default(PLAYER)
  createdAt   DateTime      @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([challengeId, userId])
  @@index([userId])
}

model Team {
  id                      String   @id @default(cuid())
  challengeId             String
  name                    String
  color                   String   @default("#6366f1")
  captainId               String?
  /// Adjoint: second in the story tie-break cascade
  deputyId                String?
  /// Jokers bought so far (jokers deferred, field prepared)
  jokersUsed              Int      @default(0)
  /// Team "aventure" channel for story votes and announcements
  discordChannelId        String?
  /// Team "librairie" channel where /ajouter-un-livre and /modifier-un-livre are allowed
  discordLibraryChannelId String?
  /// Discord role carried by the team members, created by the bot setup.
  discordRoleId           String?
  /// Pinned guide card of the *librairie* salon; republishing edits this message.
  discordGuideMessageId   String?
  createdAt               DateTime @default(now())

  challenge        Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  captain          User?             @relation("TeamCaptain", fields: [captainId], references: [id])
  deputy           User?             @relation("TeamDeputy", fields: [deputyId], references: [id])
  members          TeamMember[]
  books            Book[]
  grids            TeamGrid[]
  invites          Invite[]
  pointEvents      PointEvent[]
  modifiers        Modifier[]
  bingoFills       BingoFill[]
  targetedQuests   Quest[]           @relation("QuestTarget")
  questCompletions QuestCompletion[]
  storyState       TeamStoryState?
  storyVisits      StoryVisit[]
  votes            Vote[]
  alliancesA       Alliance[]        @relation("AllianceA")
  alliancesB       Alliance[]        @relation("AllianceB")

  @@unique([challengeId, name])
}

/// At most one team per person and per challenge (challengeId denormalised from the team).
model TeamMember {
  userId      String
  challengeId String
  teamId      String
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@index([teamId])
}

/// Admin pre-registers a Discord user id; on first login the user is attached to the team.
model Invite {
  id          String        @id @default(cuid())
  challengeId String
  discordId   String
  teamId      String?
  role        ChallengeRole @default(PLAYER)
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([challengeId, discordId])
}

/// ROMAN = full credit; GRAPHIQUE = half points (<150 p.) and ½ credit for quests/cells.
enum BookType {
  ROMAN
  GRAPHIQUE
}

/// A reading ("lecture"). Team is frozen at creation; points are computed and stored.
model Book {
  id          String    @id @default(cuid())
  userId      String
  /// Frozen at creation: a team change never moves points retroactively.
  teamId      String?
  title       String
  author      String
  pages       Int
  /// Declared by the player (BD, manga, roman graphique).
  isGraphic   Boolean   @default(false)
  /// Effective type: GRAPHIQUE when declared or when pages < 150.
  type        BookType  @default(ROMAN)
  /// Reading points, computed once and stored (rules may evolve).
  points      Decimal   @default(0) @db.Decimal(6, 1)
  finishedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  updatedById String?
  /// Soft delete (needed for cell/quest rollback history)
  deletedAt   DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("BookEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  pointEvents PointEvent[]
  bingoFill   BingoFill?
  questBook   QuestBook?

  @@index([userId])
  @@index([teamId, deletedAt])
}

/// Half-filled reading of the Discord « J'ai fini un livre » flow: what the modal
/// captured, waiting for the three dropdowns and « Valider ». Short-lived — a
/// Discord interaction token dies after 15 min — and purged by the tick.
model PendingReading {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  teamId      String?
  /// Librairie salon the flow started in; re-checked at « Valider ».
  channelId   String
  title       String
  author      String
  pages       Int
  /// Declared type; ROMAN until the dropdown says otherwise.
  type        BookType @default(ROMAN)
  questId     String?
  cellId      String?
  /// Frozen snapshot of the quest/cell dropdown options ({ quests: [], cells: [] }).
  options     Json     @default("{}")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Bingo — an ordered series of grids shared by all teams; each team plays one
// grid at a time and unlocks the next once every cell is validated.
// ---------------------------------------------------------------------------

model BingoGrid {
  id          String   @id @default(cuid())
  challengeId String
  /// Position in the series (1, 2, 3…)
  order       Int
  title       String
  size        Int      @default(5)
  createdAt   DateTime @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  cells     BingoCell[]
  fills     BingoFill[]
  teamGrids TeamGrid[]

  @@unique([challengeId, order])
}

/// A team's progression on a grid: opened when it becomes active, completed when all cells are validated.
model TeamGrid {
  id          String    @id @default(cuid())
  teamId      String
  gridId      String
  openedAt    DateTime  @default(now())
  completedAt DateTime?

  team Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  grid BingoGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)

  @@unique([teamId, gridId])
}

model BingoCell {
  id     String @id @default(cuid())
  gridId String
  row    Int
  col    Int
  prompt String

  grid  BingoGrid   @relation(fields: [gridId], references: [id], onDelete: Cascade)
  fills BingoFill[]

  @@unique([gridId, row, col])
}

/// A book placed on a team-grid cell. A cell holds up to 2 books (weights: book 1, graphique ½).
model BingoFill {
  id        String   @id @default(cuid())
  cellId    String
  gridId    String
  bookId    String   @unique
  teamId    String
  createdAt DateTime @default(now())

  cell BingoCell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  grid BingoGrid @relation(fields: [gridId], references: [id], onDelete: Cascade)
  book Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  team Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([cellId, teamId])
  @@index([gridId, teamId])
}

// ---------------------------------------------------------------------------
// Quests — team-level reading prompts, validated by attaching readings
// ---------------------------------------------------------------------------

enum QuestOrigin {
  ADMIN
  STORY
}

model Quest {
  id           String      @id @default(cuid())
  challengeId  String
  /// Display number (#1, #2…) used in commands
  number       Int
  title        String
  description  String      @default("")
  points       Int
  openAt       DateTime?
  closeAt      DateTime?
  /// When set, only this team sees/completes the quest (story-triggered rival quests).
  targetTeamId String?
  origin       QuestOrigin @default(ADMIN)
  createdAt    DateTime    @default(now())

  challenge   Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  targetTeam  Team?             @relation("QuestTarget", fields: [targetTeamId], references: [id], onDelete: Cascade)
  completions QuestCompletion[]
  books       QuestBook[]

  @@unique([challengeId, number])
}

/// A reading attached to a quest (½ credit per graphique). One quest per reading.
model QuestBook {
  id        String   @id @default(cuid())
  questId   String
  bookId    String   @unique
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([questId, teamId])
  @@index([questId, userId])
}

/// A quest validated by a team (derived from attached readings; kept for the ledger).
model QuestCompletion {
  id            String   @id @default(cuid())
  questId       String
  teamId        String
  completedById String
  createdAt     DateTime @default(now())

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([questId, teamId])
}

// ---------------------------------------------------------------------------
// Story — one branching "you're the hero" story per challenge, each team walks its own path
// ---------------------------------------------------------------------------

model Story {
  id          String   @id @default(cuid())
  challengeId String   @unique
  title       String
  /// Hours a vote stays open before auto-resolution
  voteHours   Int      @default(48)
  startNodeId String?
  createdAt   DateTime @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  nodes     StoryNode[]
}

model StoryNode {
  id                 String  @id @default(cuid())
  storyId            String
  title              String
  /// Chapter text (plain text / light markdown)
  body               String
  sortOrder          Int     @default(0)
  /// Gating: the chapter's vote only opens once the team meets every set condition
  requiredQuestId    String?
  requiredBingoLines Int?
  requiredPoints     Int?
  /// Vote duration override (hours); falls back to Story.voteHours
  voteHours          Int?
  /// Choice applied when the vote expires without a result
  defaultChoiceId    String?

  story      Story            @relation(fields: [storyId], references: [id], onDelete: Cascade)
  choices    StoryChoice[]    @relation("NodeChoices")
  incoming   StoryChoice[]    @relation("ChoiceTarget")
  teamStates TeamStoryState[]
  votes      Vote[]
  visits     StoryVisit[]

  @@index([storyId, sortOrder])
}

model StoryChoice {
  id              String  @id @default(cuid())
  nodeId          String
  label           String
  targetNodeId    String?
  /// Votable only once the team completed this quest
  lockedByQuestId String?
  /// JSON array of effects, validated by lib/story/effects.ts
  effects         Json    @default("[]")
  sortOrder       Int     @default(0)

  node    StoryNode    @relation("NodeChoices", fields: [nodeId], references: [id], onDelete: Cascade)
  target  StoryNode?   @relation("ChoiceTarget", fields: [targetNodeId], references: [id], onDelete: SetNull)
  ballots VoteBallot[]
  votes   Vote[]

  @@index([nodeId, sortOrder])
}

model TeamStoryState {
  teamId        String   @id
  currentNodeId String
  updatedAt     DateTime @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  currentNode StoryNode @relation(fields: [currentNodeId], references: [id], onDelete: Cascade)
}

model StoryVisit {
  id          String   @id @default(cuid())
  teamId      String
  nodeId      String
  choiceLabel String?
  arrivedAt   DateTime @default(now())

  team Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  node StoryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([teamId, arrivedAt])
}

enum VoteStatus {
  OPEN
  AWAITING_TARGET
  RESOLVED
}

/// Tie-break cascade: captain (5 h) → deputy (5 h) → any member + admin confirmation
enum TieStage {
  NONE
  CAPTAIN
  DEPUTY
  ANY
}

model Vote {
  id               String     @id @default(cuid())
  teamId           String
  nodeId           String
  status           VoteStatus @default(OPEN)
  deadline         DateTime
  resultChoiceId   String?
  tieStage         TieStage   @default(NONE)
  tieSince         DateTime?
  /// Choice proposed by a member at stage ANY, pending admin confirmation
  pendingChoiceId  String?
  pendingById      String?
  /// Rival team chosen by the captain for hostile/alliance effects
  targetTeamId     String?
  discordMessageId String?
  createdAt        DateTime   @default(now())
  resolvedAt       DateTime?

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  node         StoryNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  resultChoice StoryChoice? @relation(fields: [resultChoiceId], references: [id], onDelete: SetNull)
  ballots      VoteBallot[]

  @@index([teamId, status])
}

model VoteBallot {
  voteId    String
  userId    String
  choiceId  String
  createdAt DateTime @default(now())

  vote   Vote        @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice StoryChoice @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  @@id([voteId, userId])
}

/// Two allied teams: members may vote in each other's story votes.
model Alliance {
  id        String   @id @default(cuid())
  teamAId   String
  teamBId   String
  createdAt DateTime @default(now())

  teamA Team @relation("AllianceA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB Team @relation("AllianceB", fields: [teamBId], references: [id], onDelete: Cascade)

  @@unique([teamAId, teamBId])
}

// ---------------------------------------------------------------------------
// Scoring ledger — append-only source of truth for team scores
// ---------------------------------------------------------------------------

enum PointSource {
  READING
  BINGO
  QUEST
  STORY
  ADMIN
}

model PointEvent {
  id         String      @id @default(cuid())
  teamId     String
  userId     String?
  source     PointSource
  /// Final amount after multipliers, may be negative (undo, steal)
  amount     Decimal     @db.Decimal(8, 1)
  /// Amount before multiplier, for audit
  baseAmount Decimal     @db.Decimal(8, 1)
  multiplier Float       @default(1)
  label      String
  bookId     String?
  refId      String?
  createdAt  DateTime    @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

/// Temporary boost/handicap applied to a team's incoming points.
model Modifier {
  id         String   @id @default(cuid())
  teamId     String
  multiplier Float
  label      String
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startAt, endAt])
}

// ---------------------------------------------------------------------------
// FAQ — every question is a thread in the Discord "faq" forum, mirrored here
// ---------------------------------------------------------------------------

enum QuestionStatus {
  OPEN
  ANSWERED
  RESOLVED
}

model Question {
  id                   String         @id @default(cuid())
  challengeId          String
  authorId             String
  title                String
  /// Optional detail typed with the question
  body                 String         @default("")
  status               QuestionStatus @default(OPEN)
  /// Highlighted in the "Questions fréquentes" section (admins only)
  pinned               Boolean        @default(false)
  /// Thread of the Discord forum mirroring this question
  discordThreadId      String?        @unique
  /// Cursor of the incremental REST poll of that thread
  lastDiscordMessageId String?
  /// Set when the forum thread was found deleted on Discord (site-only from then on)
  discordDeletedAt     DateTime?
  createdAt            DateTime       @default(now())
  resolvedAt           DateTime?
  updatedAt            DateTime       @default(now()) @updatedAt

  challenge Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages  QuestionMessage[]

  @@index([challengeId, status])
}

/// A reply, written on the site or typed in the Discord thread (imported by the poll).
model QuestionMessage {
  id               String   @id @default(cuid())
  questionId       String
  /// Set when the author is a known player; null for a Discord-only account
  authorId         String?
  discordUserId    String?
  discordUserName  String?
  discordMessageId String?  @unique
  body             String
  isAdmin          Boolean  @default(false)
  createdAt        DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([questionId, createdAt])
}

/// Idempotency marks for bot announcements (window open/close, weekly post, dormant reminders…).
model BotEvent {
  key       String   @id
  createdAt DateTime @default(now())
}
