generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (next-auth v5) tables
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PLAYER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  role          Role      @default(PLAYER)
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  membership TeamMember?
  captainOf  Team[]      @relation("TeamCaptain")
  books      Book[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge core
// ---------------------------------------------------------------------------

enum ChallengeStatus {
  DRAFT
  ACTIVE
  FINISHED
}

model Challenge {
  id                      String          @id @default(cuid())
  name                    String
  startAt                 DateTime
  endAt                   DateTime
  status                  ChallengeStatus @default(DRAFT)
  /// Points granted per page read (e.g. 0.1 = 1 point per 10 pages)
  pointsPerPage           Float           @default(0.1)
  bingoLineBonus          Int             @default(25)
  bingoFullBonus          Int             @default(100)
  discordGuildId          String?
  discordGeneralChannelId String?
  createdAt               DateTime        @default(now())

  teams      Team[]
  invites    Invite[]
  bingoGrids BingoGrid[]
}

model Team {
  id               String   @id @default(cuid())
  challengeId      String
  name             String
  color            String   @default("#6366f1")
  captainId        String?
  discordChannelId String?
  createdAt        DateTime @default(now())

  challenge   Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  captain     User?        @relation("TeamCaptain", fields: [captainId], references: [id])
  members     TeamMember[]
  invites     Invite[]
  pointEvents PointEvent[]
  modifiers   Modifier[]
  bingoFills  BingoFill[]

  @@unique([challengeId, name])
}

model TeamMember {
  userId   String   @id
  teamId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// Admin pre-registers a Discord user id; on first login the user is attached to the team.
model Invite {
  id          String    @id @default(cuid())
  challengeId String
  discordId   String
  teamId      String?
  role        Role      @default(PLAYER)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([challengeId, discordId])
}

model Book {
  id         String   @id @default(cuid())
  userId     String
  title      String
  author     String
  pages      Int
  finishedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointEvents PointEvent[]
  bingoFills  BingoFill[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Bingo — one grid definition per scope; fills are per player or per team
// ---------------------------------------------------------------------------

enum BingoScope {
  PLAYER
  TEAM
}

model BingoGrid {
  id          String     @id @default(cuid())
  challengeId String
  scope       BingoScope
  title       String
  size        Int        @default(5)
  createdAt   DateTime   @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  cells     BingoCell[]

  @@unique([challengeId, scope])
}

model BingoCell {
  id     String @id @default(cuid())
  gridId String
  row    Int
  col    Int
  prompt String

  grid  BingoGrid   @relation(fields: [gridId], references: [id], onDelete: Cascade)
  fills BingoFill[]

  @@unique([gridId, row, col])
}

/// A book placed on a cell. Exactly one of userId (player grid) / teamId (team grid) is set.
model BingoFill {
  id        String   @id @default(cuid())
  cellId    String
  bookId    String
  userId    String?
  teamId    String?
  createdAt DateTime @default(now())

  cell BingoCell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  book Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  team Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([cellId, userId])
  @@unique([cellId, teamId])
  @@index([bookId])
}

// ---------------------------------------------------------------------------
// Scoring ledger — append-only source of truth for team scores
// ---------------------------------------------------------------------------

enum PointSource {
  READING
  BINGO
  QUEST
  STORY
  ADMIN
}

model PointEvent {
  id        String      @id @default(cuid())
  teamId    String
  userId    String?
  source    PointSource
  /// Final amount after multipliers, may be negative (undo, steal)
  amount    Int
  /// Amount before multiplier, for audit
  baseAmount Int
  multiplier Float      @default(1)
  label     String
  bookId    String?
  refId     String?
  createdAt DateTime    @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
}

/// Temporary boost/handicap applied to a team's incoming points.
model Modifier {
  id         String   @id @default(cuid())
  teamId     String
  multiplier Float
  label      String
  startAt    DateTime
  endAt      DateTime
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startAt, endAt])
}
